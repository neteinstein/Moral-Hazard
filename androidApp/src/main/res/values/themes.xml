<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge is enabled in code (enableEdgeToEdge); Compose draws everything else. -->
    <style name="Theme.MoralHazard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <style name="Theme.MoralHazard.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MoralHazard</item>
    </style>
</resources>
