root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = android_studio
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_function-naming = enabled
ktlint_standard_no-wildcard-imports = enabled
# Trailing commas are welcome but not enforced in this codebase.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_function-signature = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{swift,pbxproj}]
indent_style = tab

# Game copy lives in data sources; keep each line of prose intact instead of wrapping mid-sentence.
[**/data/**.kt]
ktlint_standard_max-line-length = disabled
